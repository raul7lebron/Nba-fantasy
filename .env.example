# API gratuita de balldontlie.io (equipos, plantillas y partidos).
# El calculo de valoracion por partido (ajuste de precios y dinero ganado)
# necesita ademas el endpoint /stats, que requiere el plan de pago ALL-STAR
# o superior: https://www.balldontlie.io
BALLDONTLIE_API_KEY=

# API gratuita de nba2kapi.com (valoraciones NBA 2K, usadas para fijar el
# precio inicial de cada jugador): https://www.nba2kapi.com
NBA2KAPI_KEY=

# Opcional: puerto del servidor (por defecto 3000)
PORT=3000

# Opcional: si tu hosting tiene disco persistente, apunta aqui para que la
# cache (data/*.json) sobreviva a los redeploys.
DATA_DIR=
